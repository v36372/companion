{
  "name": "@learning-companion/agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "node --experimental-strip-types --test *.test.mjs",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --moduleResolution bundler --module esnext --target es2022 --lib esnext,dom,dom.iterable,dom.asynciterable --skipLibCheck src/*.ts",
    "componentize": "node componentize.mjs",
    "test:mock": "node mock-provider.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "0.22.0",
    "@bytecodealliance/jco": "^1.15.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.25.0",
    "regexpu-core": "^6.5.3",
    "typescript": "^5.6.0"
  }
}
